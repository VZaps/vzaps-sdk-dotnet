root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.CA1031.severity = silent
dotnet_diagnostic.CA2007.severity = silent

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
